# Clé publique "anon" uniquement. Ne jamais mettre la clé service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Strava : identifiant public du client API (strava.com/settings/api).
# Le secret client ne va JAMAIS ici : il est un secret de la fonction Supabase strava-token.
# Le « Authorization Callback Domain » de l'app Strava doit être le domaine de l'app (localhost en local).
VITE_STRAVA_CLIENT_ID=
