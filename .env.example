# Clé publique "anon" uniquement. Ne jamais mettre la clé service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Strava : identifiant public du client API (strava.com/settings/api).
# Le secret client ne va JAMAIS ici : il est un secret de la fonction Supabase strava-token.
# Le « Authorization Callback Domain » de l'app Strava doit être le domaine de l'app (localhost en local).
VITE_STRAVA_CLIENT_ID=

# Météo-France (portail-api.meteofrance.fr) : clé de la Bulletin Vigilance, facultative.
# Préfixée VITE_ donc visible dans le navigateur : acceptable pour un prototype seulement.
# Sans clé, le critère « vigilance météo » est affiché « indisponible ».
VITE_METEOFRANCE_API_KEY=

# NASA FIRMS (firms.modaps.eosdis.nasa.gov/api/map_key) : détection de feux actifs par satellite (MODIS/VIIRS).
# Préfixée VITE_ donc visible dans le navigateur : acceptable pour un prototype seulement.
# Sans clé, le critère « risque d'incendie » est affiché « indisponible ». Avec un feu détecté près du
# tracé, le score global est forcé à 0 quels que soient les autres critères.
VITE_FIRMS_API_KEY=
